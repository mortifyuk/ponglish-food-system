NODE_ENV=production
APP_PORT=3000
PUBLIC_BASE_URL=https://orders.example.com
DATABASE_URL=postgres://ponglish:CHANGE_THIS_PASSWORD@db:5432/ponglish
POSTGRES_DB=ponglish
POSTGRES_USER=ponglish
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_ADMIN_TOKEN
CURRENCY=EGP
DELIVERY_FEE=30
DELIVERY_RADIUS_KM=10
# Restaurant coordinates are required before enabling delivery. Find these from the exact restaurant pin.
RESTAURANT_LAT=
RESTAURANT_LNG=
RESTAURANT_NAME=Ponglish Food
RESTAURANT_PHONE=
# Meta WhatsApp Cloud API (official platform)
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=
# Kashier credentials: use TEST mode first; never commit real credentials.
KASHIER_MODE=test
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
